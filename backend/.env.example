ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SEC_EDGAR_USER_AGENT="Your Name your_email@example.com"
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

LLM_PROVIDER=deepseek
LLM_MODEL=

# 留空表示 Best-of-N 的 LLM 裁判跟报告生成用同一个供应商；填 "claude"/"deepseek"
# 可以让裁判走跟生成不同的供应商，减少"用同一个模型评自己生成的内容"这种自评
# 偏好嫌疑——需要对应供应商的 API Key 也配置了才能用
JUDGE_LLM_PROVIDER=

# 默认开启：进程启动后每6小时自动预热一次板块ETF/主题篮子的行情缓存，避免
# 缓存过期后第一个真实请求撞上Polygon限速器排队刷新的冷启动。本地跑测试或
# 不想让后台悄悄发真实网络请求时改成 false
ENABLE_CACHE_WARMING=true

# 默认开启：服务启动时自动接回"跑到一半被打断"（崩溃/部署重启）的普通分析，
# 从最近的检查点接着跑，不浪费已经花掉的LLM费用。检查点存在 .cache/checkpoints/
ENABLE_TASK_RECOVERY=true
